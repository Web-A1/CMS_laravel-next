{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.17.0 <25",
    "pnpm": ">=11.1.1 <12"
  },
  "scripts": {
    "dev": "next dev",
    "dev:lan": "next dev --webpack --hostname 0.0.0.0 --port 3000",
    "build": "next build --webpack",
    "start": "next start",
    "start:lan": "next start --hostname 0.0.0.0 --port 3000",
    "test": "node --test 'src/**/*.test.ts'",
    "lint": "eslint",
    "check:images": "node ../scripts/check-image-pipeline.mjs",
    "check:media": "node ../scripts/check-public-media.mjs",
    "check:standards": "bash ../scripts/check-standards.sh"
  },
  "dependencies": {
    "lenis": "1.3.26",
    "next": "16.3.3",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
